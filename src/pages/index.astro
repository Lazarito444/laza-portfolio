---
import Layout from "../layouts/Layout.astro";
import StatusBar from "../components/StatusBar.astro";
import Nav from "../components/Nav.astro";
import Rail from "../components/Rail.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Stack from "../components/Stack.astro";
import Experience from "../components/Experience.astro";
import Code from "../components/Code.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Ariel Lázaro, Full-Stack Developer (.NET, Angular, Flutter)"
  description="Ariel Lázaro, full-stack developer in Santo Domingo, Dominican Republic. ASP.NET Core APIs, Angular web and Flutter mobile in one pair of hands, plus legacy .NET maintenance. Open to new projects."
>
  <StatusBar />
  <Nav />

  <div class="wrap">
    <div class="shell">
      <Rail />

      <main class="content" id="main">
        <Hero />
        <About />
        <Projects />
        <Stack />
        <Experience />
        <Code />
        <Contact />
      </main>
    </div>
  </div>

  <Footer />
</Layout>
