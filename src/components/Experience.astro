---
import { en } from "../data/i18n";

const t = en;
---

<section class="sec" id="experience">
  <div class="sec-top">
    <div data-od-id="experience-heading">
      <h2><span data-i18n="exp.h2a">{t("exp.h2a")}</span> <em data-i18n="exp.h2b">{t("exp.h2b")}</em></h2>
      <p data-i18n="exp.blurb">{t("exp.blurb")}</p>
    </div>
    <a
      class="link-btn"
      href="/cv/Ariel_Lazaro_Software_Developer_CV.pdf"
      download
      data-href-en="/cv/Ariel_Lazaro_Software_Developer_CV.pdf"
      data-href-es="/cv/Ariel_Lazaro_Desarrollador_Software_CV.pdf"
      data-i18n="exp.cv"
    >{t("exp.cv")}</a>
  </div>

  <div class="gitlog" data-od-id="career-log">
    <header>$ git log --career --oneline</header>

    <div class="commit" data-od-id="exp-senior">
      <span class="hash" data-i18n="exp.tag.job">{t("exp.tag.job")}</span>
      <span class="date" data-i18n="exp.c1.date">{t("exp.c1.date")}</span>
      <div>
        <b data-i18n="exp.c1.role">{t("exp.c1.role")}</b> <span data-i18n="exp.c1.rest">{t("exp.c1.rest")}</span>
        <ul>
          <li data-i18n="exp.c1.li1">{t("exp.c1.li1")}</li>
          <li data-i18n="exp.c1.li2">{t("exp.c1.li2")}</li>
        </ul>
      </div>
    </div>

    <div class="commit" data-od-id="exp-intern">
      <span class="hash" data-i18n="exp.tag.job">{t("exp.tag.job")}</span>
      <span class="date" data-i18n="exp.c2.date">{t("exp.c2.date")}</span>
      <div>
        <b data-i18n="exp.c2.role">{t("exp.c2.role")}</b> <span data-i18n="exp.c2.rest">{t("exp.c2.rest")}</span>
        <ul>
          <li data-i18n="exp.c2.li1">{t("exp.c2.li1")}</li>
          <li data-i18n="exp.c2.li2">{t("exp.c2.li2")}</li>
        </ul>
      </div>
    </div>

    <div class="commit" data-od-id="exp-education">
      <span class="hash" data-i18n="exp.tag.edu">{t("exp.tag.edu")}</span>
      <span class="date" data-i18n="exp.c3.date">{t("exp.c3.date")}</span>
      <div>
        <b data-i18n="exp.c3.role">{t("exp.c3.role")}</b> <span data-i18n="exp.c3.rest">{t("exp.c3.rest")}</span>
        <ul>
          <li data-i18n="exp.c3.li1">{t("exp.c3.li1")}</li>
          <li data-i18n="exp.c3.li2">{t("exp.c3.li2")}</li>
        </ul>
      </div>
    </div>

    <div class="commit" data-od-id="exp-unicaribe">
      <span class="hash" data-i18n="exp.tag.edu">{t("exp.tag.edu")}</span>
      <span class="date" data-i18n="exp.c4.date">{t("exp.c4.date")}</span>
      <div>
        <b data-i18n="exp.c4.role">{t("exp.c4.role")}</b> <span data-i18n="exp.c4.rest">{t("exp.c4.rest")}</span>
      </div>
    </div>

    <div class="commit" data-od-id="exp-booking">
      <span class="hash" data-i18n="exp.tag.status">{t("exp.tag.status")}</span>
      <span class="date" data-i18n="exp.c5.date">{t("exp.c5.date")}</span>
      <div>
        <b class="text-accent" data-i18n="exp.c5.role">{t("exp.c5.role")}</b> <span data-i18n="exp.c5.rest">{t("exp.c5.rest")}</span>
      </div>
    </div>
  </div>
</section>
