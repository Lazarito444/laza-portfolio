---
import { en } from "../data/i18n";

const t = en;
---

<a class="skip" href="#hero" data-i18n="nav.skip" data-od-id="skip-link">{t("nav.skip")}</a>
<div class="statusbar">
  <div class="statusbar-in">
    <span><span class="dot" aria-hidden="true">●</span> <span data-i18n="status.left">{t("status.left")}</span></span>
    <span data-i18n="status.right">{t("status.right")}</span>
  </div>
</div>
