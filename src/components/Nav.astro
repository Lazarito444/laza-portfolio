---
import { en } from "../data/i18n";

const t = en;
const links = [
  ["#hero", "nav.hero"],
  ["#about", "nav.about"],
  ["#projects", "nav.projects"],
  ["#stack", "nav.stack"],
  ["#experience", "nav.experience"],
  ["#code", "nav.code"],
  ["#contact", "nav.contact"],
] as const;
---

<header class="nav" data-od-id="site-nav">
  <div class="wrap nav-in">
    <a class="brand" href="#hero" data-od-id="brand-home">
      <span class="brand-mark" aria-hidden="true">L_</span>
      <span class="crumbs"><b>~/lazarito.dev</b> / portfolio</span>
    </a>

    <nav class="nav-links" id="navLinks" data-od-id="primary-nav" data-i18n-aria="nav.label" aria-label={t("nav.label")}>
      {links.map(([href, key]) => (
        <a href={href} data-i18n={key}>{t(key)}</a>
      ))}
    </nav>

    <div class="nav-right">
      <a class="btn btn-lime px-4 py-2.5 min-h-[40px]" href="#contact" data-i18n="nav.hire" data-od-id="nav-hire-btn">{t("nav.hire")}</a>

      <button
        class="icon-btn"
        id="themeBtn"
        type="button"
        role="switch"
        aria-checked="true"
        aria-label={t("ctrl.toLight")}
        title={t("ctrl.toLight")}
        data-od-id="theme-toggle"
      >
        <svg data-theme-icon="dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"/></svg>
        <svg data-theme-icon="light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6L19 19M19 5l-1.4 1.4M6.4 17.6L5 19"/></svg>
      </button>

      <div class="lang" role="group" data-i18n-aria="ctrl.lang" aria-label={t("ctrl.lang")} data-od-id="lang-toggle">
        <button type="button" data-lang="en" aria-pressed="true" data-od-id="lang-en">EN</button>
        <button type="button" data-lang="es" aria-pressed="false" data-od-id="lang-es">ES</button>
      </div>

      <button
        class="menu-btn"
        id="menuBtn"
        type="button"
        aria-expanded="false"
        aria-controls="navLinks"
        aria-label={t("nav.menu")}
        data-i18n-aria="nav.menu"
        data-od-id="menu-toggle"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
